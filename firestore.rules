/**
 * Scoorla - Firebase Firestore Security Rules
 * 
 * Enforces:
 * - Strict role-based access control
 * - No cross-school data access
 * - Admin-only system operations
 * - Teacher access limited to assigned content
 * - Validated access codes for class/subject teachers
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============ HELPER FUNCTIONS ============
    
    // Get current user ID
    function currentUser() {
      return request.auth.uid;
    }
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user's role from users document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(currentUser())).data.role;
    }
    
    // Get user's schoolId from users document
    function getUserSchoolId() {
      return get(/databases/$(database)/documents/users/$(currentUser())).data.schoolId;
    }
    
    // Check if user is admin
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    // Check if user is class teacher
    function isClassTeacher() {
      return getUserRole() == 'class_teacher';
    }
    
    // Check if user is subject teacher
    function isSubjectTeacher() {
      return getUserRole() == 'subject_teacher';
    }
    
    // Check if user belongs to same school
    function isSameSchool(schoolId) {
      return getUserSchoolId() == schoolId;
    }
    
    // ============ USER DOCUMENTS ============
    
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && currentUser() == userId;
      
      // Users can write to their own document (limited fields)
      allow write: if isAuthenticated() && currentUser() == userId && 
        request.resource.data.keys().hasOnly(['role', 'schoolId', 'email', 'roleUpdatedAt', 'createdAt', 'onboardingComplete']);
      
      // Only admins can read all user data in their school (for reports, etc.)
      allow read: if isAuthenticated() && isAdmin() && isSameSchool(resource.data.schoolId);
      
      // Nested onboarding subcollection
      match /onboarding/{document=**} {
        allow read, write: if isAuthenticated() && currentUser() == userId;
      }
    }
    
    // ============ SCHOOL DOCUMENTS ============
    
    match /schools/{schoolId} {
      // Only admins from this school can read/write
      allow read: if isAuthenticated() && getUserSchoolId() == schoolId;
      allow write: if isAuthenticated() && isAdmin() && getUserSchoolId() == schoolId;
      
      // ============ CLASS TEACHER ACCESS CODES ============
      
      match /accessCodes/classTeacherCodes/{classId} {
        // Admins can read/write their school's access codes
        allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
        
        // Only validate on read (for class teachers accessing their class)
        allow read: if isAuthenticated() && resource.data.schoolId == getUserSchoolId();
      }
      
      // ============ SUBJECT TEACHER ACCESS CODES ============
      
      match /accessCodes/subjectTeacherCodes/{subjectId} {
        // Admins can read/write their school's access codes
        allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
        
        // Only validate on read (for subject teachers accessing their subject)
        allow read: if isAuthenticated() && resource.data.schoolId == getUserSchoolId();
      }
      
      // ============ CLASS DATA ============
      
      match /classes/{classId} {
        // Admins: full access
        allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
        
        // Class teachers: read only their assigned class
        allow read: if isAuthenticated() && isClassTeacher() && isSameSchool(schoolId);
        
        // ============ STUDENT DATA ============
        
        match /students/{studentId} {
          // Admins: full access
          allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
          
          // Class teachers: read/write students in their class
          allow read, write: if isAuthenticated() && isClassTeacher() && isSameSchool(schoolId);
          
          // Subject teachers: read only
          allow read: if isAuthenticated() && isSubjectTeacher() && isSameSchool(schoolId);
        }
        
        // ============ SUBJECT SCORES ============
        
        match /subjects/{subjectId} {
          // Admins: full access
          allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
          
          // Class teachers: read all subjects
          allow read: if isAuthenticated() && isClassTeacher() && isSameSchool(schoolId);
          
          // Subject teachers: read/write only their subject
          // Note: actual subject filtering handled in application layer
          allow read, write: if isAuthenticated() && isSubjectTeacher() && isSameSchool(schoolId);
          
          match /scores/{scoreId} {
            // Admins: full access
            allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
            
            // Class teachers: read all scores
            allow read: if isAuthenticated() && isClassTeacher() && isSameSchool(schoolId);
            
            // Subject teachers: read/write only their subject scores
            allow read, write: if isAuthenticated() && isSubjectTeacher() && isSameSchool(schoolId);
          }
        }
        
        // ============ RESULTS ============
        
        match /results/{resultId} {
          // Admins: full access
          allow read, write: if isAuthenticated() && isAdmin() && isSameSchool(schoolId);
          
          // Class teachers: read only
          allow read: if isAuthenticated() && isClassTeacher() && isSameSchool(schoolId);
          
          // Subject teachers: read only
          allow read: if isAuthenticated() && isSubjectTeacher() && isSameSchool(schoolId);
        }
      }
    }
    
    // ============ BLOCK ALL OTHER PATHS ============
    
    // Deny all access to any other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
